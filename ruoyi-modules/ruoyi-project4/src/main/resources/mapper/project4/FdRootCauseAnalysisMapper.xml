<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ruoyi.project4.mapper.FdRootCauseAnalysisMapper">

    <resultMap type="FdRootCauseAnalysis" id="FdRootCauseAnalysisResult">
        <result property="analysisId" column="analysis_id"/>
        <result property="analysisCode" column="analysis_code"/>
        <result property="diagnosisId" column="diagnosis_id"/>
        <result property="sampleId" column="sample_id"/>
        <result property="rootCauseType" column="root_cause_type"/>
        <result property="rootCauseDesc" column="root_cause_desc"/>
        <result property="probability" column="probability"/>
        <result property="evidenceJson" column="evidence_json"/>
        <result property="maintenanceSuggestion" column="maintenance_suggestion"/>
        <result property="analysisMethod" column="analysis_method"/>
        <result property="analysisStatus" column="analysis_status"/>
        <result property="analyst" column="analyst"/>
        <result property="analysisTime" column="analysis_time"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectFdRootCauseAnalysisVo">
        SELECT
            analysis_id,
            analysis_code,
            diagnosis_id,
            sample_id,
            root_cause_type,
            root_cause_desc,
            probability,
            evidence_json,
            maintenance_suggestion,
            analysis_method,
            analysis_status,
            analyst,
            analysis_time,
            del_flag,
            create_by,
            create_time,
            update_by,
            update_time,
            remark
        FROM t4_root_cause_analysis
    </sql>

    <!-- 查询故障诊断-根因分析结果列表 -->
    <select id="selectFdRootCauseAnalysisList" parameterType="FdRootCauseAnalysis" resultMap="FdRootCauseAnalysisResult">
        <include refid="selectFdRootCauseAnalysisVo"/>
        <where>
            (del_flag = '0' OR del_flag IS NULL)

            <if test="analysisCode != null and analysisCode != ''">
                AND analysis_code LIKE CONCAT('%', #{analysisCode}, '%')
            </if>

            <if test="diagnosisId != null">
                AND diagnosis_id = #{diagnosisId}
            </if>

            <if test="sampleId != null">
                AND sample_id = #{sampleId}
            </if>

            <if test="rootCauseType != null and rootCauseType != ''">
                AND root_cause_type = #{rootCauseType}
            </if>

            <if test="rootCauseDesc != null and rootCauseDesc != ''">
                AND root_cause_desc LIKE CONCAT('%', #{rootCauseDesc}, '%')
            </if>

            <if test="probability != null">
                AND probability = #{probability}
            </if>

            <if test="analysisMethod != null and analysisMethod != ''">
                AND analysis_method LIKE CONCAT('%', #{analysisMethod}, '%')
            </if>

            <if test="analysisStatus != null and analysisStatus != ''">
                AND analysis_status = #{analysisStatus}
            </if>

            <if test="analyst != null and analyst != ''">
                AND analyst LIKE CONCAT('%', #{analyst}, '%')
            </if>

            <if test="analysisTime != null">
                AND DATE(analysis_time) = DATE(#{analysisTime})
            </if>
        </where>
        ORDER BY analysis_id DESC
    </select>

    <!-- 根据根因分析ID查询故障诊断-根因分析结果 -->
    <select id="selectFdRootCauseAnalysisByAnalysisId" parameterType="Long" resultMap="FdRootCauseAnalysisResult">
        <include refid="selectFdRootCauseAnalysisVo"/>
        WHERE analysis_id = #{analysisId}
        AND (del_flag = '0' OR del_flag IS NULL)
    </select>

    <!-- 新增故障诊断-根因分析结果 -->
    <insert id="insertFdRootCauseAnalysis" parameterType="FdRootCauseAnalysis" useGeneratedKeys="true" keyProperty="analysisId">
        INSERT INTO t4_root_cause_analysis
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="analysisCode != null and analysisCode != ''">analysis_code,</if>
            <if test="diagnosisId != null">diagnosis_id,</if>
            <if test="sampleId != null">sample_id,</if>
            <if test="rootCauseType != null and rootCauseType != ''">root_cause_type,</if>
            <if test="rootCauseDesc != null and rootCauseDesc != ''">root_cause_desc,</if>
            <if test="probability != null">probability,</if>
            <if test="evidenceJson != null and evidenceJson != ''">evidence_json,</if>
            <if test="maintenanceSuggestion != null and maintenanceSuggestion != ''">maintenance_suggestion,</if>
            <if test="analysisMethod != null and analysisMethod != ''">analysis_method,</if>
            <if test="analysisStatus != null and analysisStatus != ''">analysis_status,</if>
            <if test="analyst != null and analyst != ''">analyst,</if>
            <if test="analysisTime != null">analysis_time,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null and remark != ''">remark,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="analysisCode != null and analysisCode != ''">#{analysisCode},</if>
            <if test="diagnosisId != null">#{diagnosisId},</if>
            <if test="sampleId != null">#{sampleId},</if>
            <if test="rootCauseType != null and rootCauseType != ''">#{rootCauseType},</if>
            <if test="rootCauseDesc != null and rootCauseDesc != ''">#{rootCauseDesc},</if>
            <if test="probability != null">#{probability},</if>
            <if test="evidenceJson != null and evidenceJson != ''">#{evidenceJson},</if>
            <if test="maintenanceSuggestion != null and maintenanceSuggestion != ''">#{maintenanceSuggestion},</if>
            <if test="analysisMethod != null and analysisMethod != ''">#{analysisMethod},</if>
            <if test="analysisStatus != null and analysisStatus != ''">#{analysisStatus},</if>
            <if test="analyst != null and analyst != ''">#{analyst},</if>
            <if test="analysisTime != null">#{analysisTime},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <!-- 修改故障诊断-根因分析结果 -->
    <update id="updateFdRootCauseAnalysis" parameterType="FdRootCauseAnalysis">
        UPDATE t4_root_cause_analysis
        <trim prefix="SET" suffixOverrides=",">
            <if test="analysisCode != null and analysisCode != ''">analysis_code = #{analysisCode},</if>
            <if test="diagnosisId != null">diagnosis_id = #{diagnosisId},</if>
            <if test="sampleId != null">sample_id = #{sampleId},</if>
            <if test="rootCauseType != null and rootCauseType != ''">root_cause_type = #{rootCauseType},</if>
            <if test="rootCauseDesc != null and rootCauseDesc != ''">root_cause_desc = #{rootCauseDesc},</if>
            <if test="probability != null">probability = #{probability},</if>
            <if test="evidenceJson != null and evidenceJson != ''">evidence_json = #{evidenceJson},</if>
            <if test="maintenanceSuggestion != null and maintenanceSuggestion != ''">maintenance_suggestion = #{maintenanceSuggestion},</if>
            <if test="analysisMethod != null and analysisMethod != ''">analysis_method = #{analysisMethod},</if>
            <if test="analysisStatus != null and analysisStatus != ''">analysis_status = #{analysisStatus},</if>
            <if test="analyst != null and analyst != ''">analyst = #{analyst},</if>
            <if test="analysisTime != null">analysis_time = #{analysisTime},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        WHERE analysis_id = #{analysisId}
    </update>

    <!-- 删除单条故障诊断-根因分析结果：逻辑删除 -->
    <update id="deleteFdRootCauseAnalysisByAnalysisId" parameterType="Long">
        UPDATE t4_root_cause_analysis
        SET del_flag = '2'
        WHERE analysis_id = #{analysisId}
    </update>

    <!-- 批量删除故障诊断-根因分析结果：逻辑删除 -->
    <update id="deleteFdRootCauseAnalysisByAnalysisIds" parameterType="Long">
        UPDATE t4_root_cause_analysis
        SET del_flag = '2'
        WHERE analysis_id IN
        <foreach item="analysisId" collection="array" open="(" separator="," close=")">
            #{analysisId}
        </foreach>
    </update>

    <!-- 查询根因分析置信度统计，用于前端饼状图 -->
    <select id="selectConfidenceStats" parameterType="FdRootCauseAnalysis" resultType="java.util.HashMap">
        SELECT
        COUNT(*) AS total,
        IFNULL(SUM(CASE WHEN analysis_status = '已分析' THEN 1 ELSE 0 END), 0) AS analyzedCount,
        IFNULL(SUM(CASE WHEN analysis_status = '待复核' THEN 1 ELSE 0 END), 0) AS pendingCount,
        IFNULL(AVG(probability), 0) AS avgConfidence,
        IFNULL(SUM(CASE WHEN probability >= 0.8 THEN 1 ELSE 0 END), 0) AS highCount,
        IFNULL(SUM(CASE WHEN probability >= 0.6 AND probability &lt; 0.8 THEN 1 ELSE 0 END), 0) AS mediumCount,
        IFNULL(SUM(CASE WHEN probability &lt; 0.6 THEN 1 ELSE 0 END), 0) AS lowCount
        FROM t4_root_cause_analysis
        <where>
            (del_flag = '0' OR del_flag IS NULL)

            <if test="analysisCode != null and analysisCode != ''">
                AND analysis_code LIKE CONCAT('%', #{analysisCode}, '%')
            </if>

            <if test="diagnosisId != null">
                AND diagnosis_id = #{diagnosisId}
            </if>

            <if test="sampleId != null">
                AND sample_id = #{sampleId}
            </if>

            <if test="rootCauseType != null and rootCauseType != ''">
                AND root_cause_type = #{rootCauseType}
            </if>

            <if test="analysisStatus != null and analysisStatus != ''">
                AND analysis_status = #{analysisStatus}
            </if>

            <if test="analyst != null and analyst != ''">
                AND analyst LIKE CONCAT('%', #{analyst}, '%')
            </if>

            <if test="analysisTime != null">
                AND DATE(analysis_time) = DATE(#{analysisTime})
            </if>
        </where>
    </select>

</mapper>
