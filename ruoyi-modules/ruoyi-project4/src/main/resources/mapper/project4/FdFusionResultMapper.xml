<mapper namespace="com.ruoyi.project4.mapper.FdFusionResultMapper">
    
    <resultMap type="FdFusionResult" id="FdFusionResultResult">
        <result property="fusionId"    column="fusion_id"    />
        <result property="fusionCode"    column="fusion_code"    />
        <result property="sampleId"    column="sample_id"    />
        <result property="sampleCode"    column="sample_code"    />
        <result property="featureIds"    column="feature_ids"    />
        <result property="fusionMethod"    column="fusion_method"    />
        <result property="confidenceWeight"    column="confidence_weight"    />
        <result property="outputDimension"    column="output_dimension"    />
        <result property="vectorLength"    column="vector_length"    />
        <result property="vectorJson"    column="vector_json"    />
        <result property="vectorPath"    column="vector_path"    />
        <result property="algorithmVersion"    column="algorithm_version"    />
        <result property="generateTime"    column="generate_time"    />
        <result property="resultStatus"    column="result_status"    />
        <result property="delFlag"    column="del_flag"    />
