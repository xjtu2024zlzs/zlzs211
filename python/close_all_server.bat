@echo off
chcp 65001 >nul
title 关闭全部 FastAPI 服务端口

echo ==================================================
echo 正在关闭 FastAPI 相关端口
echo ==================================================

for %%p in (
    9701
    9711
    9712
    9713
    9714
    9715
    9721
    9741
    9761
    9781
    9782
) do (
    echo.
    echo 正在检查端口 %%p ...
    for /f "tokens=5" %%a in ('netstat -ano ^| findstr :%%p') do (
        echo 端口 %%p 对应 PID %%a，正在结束进程...
        taskkill /F /PID %%a
    )
)

echo.
echo ==================================================
echo 端口清理完成。
echo ==================================================
pause